# Copy to .env and edit. Never commit .env.

# dry  = simulated trades, fake payouts, nothing touches the chain
# live = real trades, real fee claims, real payouts
MODE=dry
PORT=8787
ADMIN_TOKEN=change-me

# ---- Coin (live mode) ----
MINT=
TOKEN_SYMBOL=PINATA
# X account shown on the site: a handle (@name) or a full https://x.com/... link
X_URL=
# What the coin trades against on pump.fun, which is also what creator fees arrive in.
# $PUMP is pumpCmXqMfrsAkQ5r49WcJnRayYRqmXz6ae8H7H9Dfn. Leave empty for a normal SOL coin.
QUOTE_MINT=
QUOTE_SYMBOL=PUMP
RPC_URL=
# Optional and not needed: the RPC websocket already makes hits near-instant.
PUMPPORTAL_API_KEY=
JUPITER_API_KEY=
# Creator/treasury wallet. Use ONE of these. Launch the coin from a fresh wallet
# that holds nothing but creator fees.
TREASURY_SECRET_KEY=
TREASURY_KEYFILE=

# ---- Game rules ----
MAX_HP_USD=3000
SELL_HEAL_FACTOR=0.5
MIN_BUY_USD=10
MIN_POT_USD=150
DECAY_AFTER_HOURS=6
DECAY_PCT_PER_HOUR=10
NEXT_ROUND_DELAY_SEC=30
# Minutes to wait after a break before checking holders and paying. 0 = instant.
HOLD_WINDOW_MIN=0
# Comma-separated wallets that can never win
BLOCKLIST=

# ---- Rewards ----
SPLIT_PACKS=25
SPLIT_BUYBACK=25
SPLIT_USDC=50
# Breaker first, then the four biggest buys
WEIGHTS=30,25,20,15,10
PACK_TIERS=25,50,100
MAX_PACKS_PER_WINNER=3
# SOL always left in the prize wallet for network fees. It is never part of the pool.
GAS_FLOAT_SOL=0.05
SLIPPAGE_BPS=200
GACHA_URL=https://gacha.collectorcrypt.com
# Optional. Collector Crypt works without a key.
COLLECTOR_CRYPT_API_KEY=
COLLECTOR_CRYPT_PAYMENT_WALLET=GachaNgyXTU3zFogQ8Z5jR2BLXs8215X2AtEH18VxJq3
# Priority fee per compute unit, and how often the trade ledger polls the RPC
PRIORITY_MICROLAMPORTS=100000
LEDGER_POLL_MS=2500
# Fees worth less than this many dollars are not claimed or swapped yet. Lower it for a small test round.
MIN_CLAIM_USD=0.5

# ---- Dry-run simulator ----
# Demo price of the fee token trades are made in ($PUMP)
SIM_QUOTE_USD=0.0034
SIM_START_POT_USD=400
SIM_FEE_RATE=0.01
SIM_TRADES_PER_MIN=45
