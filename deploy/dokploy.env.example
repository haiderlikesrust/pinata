# Paste into the application's Environment tab in Dokploy. Do not commit filled-in values.
# These are runtime settings: change one, redeploy, and the update still has no downtime.

# dry  = public demo with simulated trades and simulated payouts. Start here.
# live = real trades, real fee claims, real payouts.
MODE=dry
# Protects /admin/*. Use a long random string.
ADMIN_TOKEN=

# ---- Shown on the site ----
TOKEN_SYMBOL=PINATA
# The coin's mint. Appears as the contract address (CA) and powers the buy button. Empty = "drops at launch".
MINT=
# X account: a handle (@name) or a full https://x.com/... link. Empty = "Soon".
X_URL=

# ---- Live mode only ----
# What the coin trades against on pump.fun, which is also what creator fees arrive in.
# $CARDS is CARDSccUMFKoPRZxt5vt3ksUbxEFEcnZ3H2pd3dKxYjp. Leave empty for a normal SOL coin.
QUOTE_MINT=CARDSccUMFKoPRZxt5vt3ksUbxEFEcnZ3H2pd3dKxYjp
QUOTE_SYMBOL=CARDS
# A paid mainnet RPC (Helius, Triton, QuickNode).
RPC_URL=
JUPITER_API_KEY=
# Optional: makes hits appear instantly instead of a few seconds late.
PUMPPORTAL_API_KEY=
# The coin's creator wallet, which is also the prize wallet. Base58 secret key, or a JSON array of 64 bytes.
# Never put this in Build-time Arguments.
TREASURY_SECRET_KEY=
# Optional. Collector Crypt works without a key.
COLLECTOR_CRYPT_API_KEY=

# ---- Game rules ----
MAX_HP_USD=3000
SELL_HEAL_FACTOR=0.5
MIN_BUY_USD=10
MIN_POT_USD=150
DECAY_AFTER_HOURS=6
DECAY_PCT_PER_HOUR=10
NEXT_ROUND_DELAY_SEC=30
HOLD_WINDOW_MIN=0
BLOCKLIST=

# ---- Rewards ----
SPLIT_PACKS=25
SPLIT_BUYBACK=25
SPLIT_USDC=50
WEIGHTS=30,25,20,15,10
PACK_TIERS=25,50,100
MAX_PACKS_PER_WINNER=3
# SOL always left in the prize wallet for network fees. It is never part of the pool.
GAS_FLOAT_SOL=0.05
SLIPPAGE_BPS=200
